# --- JetBrokers ---------------------------------------------------------
# ID de organización: es el que aparece en las URLs del API.
JETBROKERS_ORG_ID=
# Base del API. Cámbiala para apuntar al mock local: http://localhost:4010
JETBROKERS_BASE_URL=https://api.jetbrokers.io
# En false (por defecto) el gestor NO crea clientes en el CRM: solo simula.
JETBROKERS_ESCRITURA=false
# true si tu IP de salida está en la whitelist de JetBrokers (900 POST/hora
# en vez de 10).
JETBROKERS_IP_WHITELIST=false
# Email del ejecutivo al que se asignan los clientes creados.
JETBROKERS_ASIGNAR_A=

# --- Claude -------------------------------------------------------------
# Sin credencial, el gestor usa la heurística local y sigue funcionando.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Persistencia (opcional) --------------------------------------------
# Sin esto, los datos viven en memoria y se pierden al reiniciar.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gestor -------------------------------------------------------------
# Firma de los mensajes que redacta el agente.
GESTOR_FIRMA=Equipo Comercial
# Token que exige POST /api/leads y POST /api/agente. Vacío = ruta abierta.
INGESTA_TOKEN=

# --- WhatsApp (Meta Cloud API) ------------------------------------------
# Sin esto, los mensajes quedan en la bandeja simulada de /mensajeria.
WHATSAPP_TOKEN=
# ID del número, no el número. Lo entrega el WhatsApp Manager.
WHATSAPP_PHONE_NUMBER_ID=
# App secret: verifica la firma del webhook. Sin él, los webhooks se rechazan.
WHATSAPP_APP_SECRET=
# Token que tú inventas y que Meta repite en el desafío GET del webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_VERSION=v23.0
# En false (por defecto) no sale nada a la red.
WHATSAPP_ENVIO=false

# --- Correo (Resend) ----------------------------------------------------
RESEND_API_KEY=
# Remitente con nombre: "Prosperity Latam <hola@corredora.cl>"
CORREO_REMITENTE=
# Dominio configurado para recibir (registro MX de Resend).
CORREO_DOMINIO_RESPUESTA=
# Casilla base del alias con token: documentos+<token>@dominio
CORREO_BUZON_RESPUESTA=documentos
# Secreto de firma del webhook de Resend (empieza con whsec_).
RESEND_WEBHOOK_SECRET=
CORREO_ENVIO=false

# --- Documentos y datos personales --------------------------------------
# Días que se conservan los documentos. Va informado en el correo.
DOCUMENTOS_DIAS_RETENCION=180
# Casilla para ejercer derechos sobre los datos (Ley 21.719).
CONTACTO_PROTECCION_DATOS=datos@corredora.cl
NOMBRE_CORREDORA=
